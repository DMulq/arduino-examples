void drawBevelBox(int16_t x, int16_t y, int16_t w, int16_t h, uint16_t fill, bool pressed = false) {
  gfx->fillRect(x, y, w, h, fill);
  uint16_t topCol = pressed ? C_UI_BORDER_DK : C_UI_BORDER_LT;
  uint16_t botCol = pressed ? C_UI_BORDER_LT : C_UI_BORDER_DK;
  gfx->drawFastHLine(x, y, w, topCol);
  gfx->drawFastVLine(x, y, h, topCol);
  gfx->drawFastHLine(x, y + h - 1, w, botCol);
  gfx->drawFastVLine(x + w - 1, y, h, botCol);
}

void drawSegmentedBar(int16_t x, int16_t y, int16_t w, int16_t h, float value, uint16_t barColor) {
  drawBevelBox(x, y, w, h, C_BLACK, true);
  int segments = 8;
  int segW = (w - 4 - (segments - 1) * 2) / segments;
  int activeSegs = (int)((value / 100.0f) * segments + 0.5f);

  for (int i = 0; i < segments; i++) {
    int sx = x + 2 + i * (segW + 2);
    if (i < activeSegs) {
      gfx->fillRect(sx, y + 2, segW, h - 4, barColor);
      gfx->drawFastHLine(sx, y + 2, segW, C_WHITE);
    } else {
      gfx->fillRect(sx, y + 2, segW, h - 4, 0x18E3);
    }
  }
}

void drawBatteryIcon(int16_t x, int16_t y, uint8_t pct, bool charging) {
  gfx->fillRect(x, y, 26, 14, C_BLACK);
  gfx->drawRect(x, y, 23, 14, C_UI_BORDER_LT);
  gfx->drawFastVLine(x + 23, y + 4, 6, C_UI_BORDER_LT);
  gfx->drawFastVLine(x + 24, y + 4, 6, C_UI_BORDER_LT);

  int fillW = (pct * 19) / 100;
  if (fillW > 19) fillW = 19;

  uint16_t col = C_BAT_GREEN;
  if (pct <= 20) col = C_DANGER_RED;
  else if (pct <= 50) col = C_BAT_YELLOW;

  if (fillW > 0) {
    gfx->fillRect(x + 2, y + 2, fillW, 10, col);
  }

  if (charging) {
    gfx->setTextColor(C_WIN_SUN);
    gfx->setTextSize(1);
    gfx->setCursor(x + 7, y + 3);
    gfx->print("+");
  }
}

void readBatteryPMIC() {
  Wire.beginTransmission(AXP2101_ADDR);
  Wire.write(0x00);
  if (Wire.endTransmission() == 0) {
    if (Wire.requestFrom((uint8_t)AXP2101_ADDR, (uint8_t)1) == 1) {
      uint8_t reg00 = Wire.read();
      isCharging = (reg00 & (1 << 5)) != 0;
    }
  }

  Wire.beginTransmission(AXP2101_ADDR);
  Wire.write(0xA4);
  if (Wire.endTransmission() == 0) {
    if (Wire.requestFrom((uint8_t)AXP2101_ADDR, (uint8_t)1) == 1) {
      uint8_t raw = Wire.read();
      if (raw <= 100) {
        batteryPercent = raw;
      }
    }
  }
}

void savePetData() {
  prefs.begin("pockipet", false);
  prefs.putFloat("hunger", hunger);
  prefs.putFloat("happiness", happiness);
  prefs.putFloat("energy", energy);
  prefs.putUInt("days", daysAlive);
  prefs.putUChar("state", (uint8_t)currentState);
  prefs.putUInt("starve", starveStartTime);

  RTC_DateTime dt = rtc.getDateTime();
  uint8_t hour = min((uint8_t)23, dt.getHour());
  uint8_t minVal = min((uint8_t)59, dt.getMinute());
  uint8_t dayVal = max((uint8_t)1, min((uint8_t)31, dt.getDay()));

  uint32_t rtcStamp = ((uint32_t)dayVal * 86400UL) +
                      ((uint32_t)hour * 3600UL) +
                      ((uint32_t)minVal * 60UL) +
                      dt.getSecond();
  prefs.putUInt("lastRtc", rtcStamp);
  prefs.end();
}

void loadPetData() {
  prefs.begin("pockipet", true);
  if (prefs.isKey("hunger")) {
    hunger = prefs.getFloat("hunger", 85.0f);
    happiness = prefs.getFloat("happiness", 90.0f);
    energy = prefs.getFloat("energy", 75.0f);
    daysAlive = prefs.getUInt("days", 1);
    currentState = (PetState)prefs.getUChar("state", (uint8_t)STATE_IDLE);
    starveStartTime = prefs.getUInt("starve", 0);

    uint32_t lastRtc = prefs.getUInt("lastRtc", 0);
    prefs.end();

    if (lastRtc > 0) {
      RTC_DateTime dt = rtc.getDateTime();
      uint8_t hour = min((uint8_t)23, dt.getHour());
      uint8_t minVal = min((uint8_t)59, dt.getMinute());
      uint8_t dayVal = max((uint8_t)1, min((uint8_t)31, dt.getDay()));

      uint32_t nowRtc = ((uint32_t)dayVal * 86400UL) +
                        ((uint32_t)hour * 3600UL) +
                        ((uint32_t)minVal * 60UL) +
                        dt.getSecond();

      if (nowRtc > lastRtc && (nowRtc - lastRtc) < (86400UL * 30)) { // Safety guard against RTC spikes
        uint32_t elapsedSec = nowRtc - lastRtc;
        float decayRate = (currentState == STATE_SLEEP) ? (0.0058f / 5.0f) : (0.0174f / 5.0f);
        hunger = max(0.0f, hunger - (elapsedSec * decayRate));
        happiness = max(0.0f, happiness - (elapsedSec * (0.012f / 5.0f)));

        if (currentState == STATE_SLEEP) {
          energy = min(100.0f, energy + (elapsedSec * (0.35f / 5.0f)));
        } else {
          energy = max(0.0f, energy - (elapsedSec * (0.010f / 5.0f)));
        }

        if (hunger <= 0.0f && elapsedSec >= 7200) {
          currentState = STATE_DEAD;
        }
      }
    }
  } else {
    prefs.end();
    savePetData();
  }
}

