// --- Chiptune Audio Synthesizer ---
void playTone(uint16_t freq, uint16_t durationMs) {
  #if BUZZER_PIN >= 0
    tone(BUZZER_PIN, freq, durationMs);
    delay(durationMs);
    noTone(BUZZER_PIN);
  #endif
}

void soundFeed() {
  playTone(1046, 70); // C6
  delay(15);
  playTone(1318, 90); // E6
}

void soundPlay() {
  playTone(1046, 50); // C6
  delay(10);
  playTone(1318, 50); // E6
  delay(10);
  playTone(1568, 110); // G6
}

void soundSleep() {
  playTone(784, 90);  // G5
  delay(20);
  playTone(523, 140); // C5
}

void soundStarveAlarm() {
  playTone(2093, 70); // High warning C7
  delay(30);
  playTone(2093, 70);
}

void soundRevive() {
  playTone(523, 70);  // C5
  delay(15);
  playTone(659, 70);  // E5
  delay(15);
  playTone(784, 70);  // G5
  delay(15);
  playTone(1046, 180);// C6
}

// --- RTC Auto-Calibrator from Upload Timestamp ---
void calibrateRtcFromBuildTime() {
  const char* dateStr = __DATE__; // "Mmm dd yyyy"
  const char* timeStr = __TIME__; // "hh:mm:ss"

  char monthName[4];
  int day = 1, year = 2026, hour = 12, min = 0, sec = 0;

  sscanf(dateStr, "%3s %d %d", monthName, &day, &year);
  sscanf(timeStr, "%d:%d:%d", &hour, &min, &sec);

  const char* months[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", 
                          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
  int month = 1;
  for (int i = 0; i < 12; i++) {
    if (strncmp(monthName, months[i], 3) == 0) {
      month = i + 1;
      break;
    }
  }

  rtc.setDateTime(year, month, day, hour, min, sec);
}

