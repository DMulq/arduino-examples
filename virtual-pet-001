  gfx->fillEllipse(cx, cy, 95, 38, C_RUG_INNER);
  gfx->drawEllipse(cx, cy, 110, 48, C_WOOD_DARK);

  RTC_DateTime dt = rtc.getDateTime();
  uint8_t hour = min((uint8_t)23, dt.getHour());
  bool isNight = (hour >= 20 || hour < 7);

  int winX = 26;
  int winY = 28;
  int winW = 68;
  int winH = 82;

  drawBevelBox(winX, winY, winW, winH, C_WIN_FRAME, false);
  uint16_t skyColor = isNight ? C_WIN_SKY_NIGHT : C_WIN_SKY_DAY;
  gfx->fillRect(winX + 4, winY + 4, winW - 8, winH - 8, skyColor);

  if (!isNight) {
    gfx->fillCircle(winX + 22, winY + 24, 10, C_WIN_SUN);
