void drawPet(int state, int offsetX) {
  int scale = 7; 
  int petWidth = 24 * scale;
  int petHeight = 24 * scale;
  int baseScreenX = (LCD_WIDTH - petWidth) / 2;
  int petX = baseScreenX + offsetX;
  int petY = 50;

  gfx->fillRect(0, 45, LCD_WIDTH, 175, 0x0000);

  const uint8_t (*activeSprite)[24];
  if (state == 1) activeSprite = petBlink;
  else if (state == 2) activeSprite = petYawn;
  else if (state == 3) activeSprite = petSmile;
  else activeSprite = petNormal;

  for (int row = 0; row < 24; row++) {
    for (int col = 0; col < 24; col++) {
      if (activeSprite[row][col] == 1) {
        gfx->fillRect(petX + (col * scale), petY + (row * scale), scale, scale, RGB565_WHITE);
      }
    }
  }
}

void drawUIElements(bool buttonPressed = false) {
  // Happiness Bar Header
  gfx->fillRect(0, 10, LCD_WIDTH, 25, 0x0000);
  gfx->setTextSize(1, 1, 0);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setCursor(35, 15);
  gfx->print("HAPPINESS:");

  int startX = 115;
  for (int i = 0; i < 10; i++) {
    if (i < happiness) {
      gfx->fillRect(startX + (i * 9), 13, 7, 10, RGB565_WHITE);
    } else {
      gfx->drawRect(startX + (i * 9), 13, 7, 10, RGB565_WHITE);
    }
  }

  // Mood Text
  char moodStr[25];
  if (happiness <= 3) {
    strcpy(moodStr, "MOOD: HUNGRY");
  } else if (happiness >= 8) {
    strcpy(moodStr, "MOOD: EXCITED");
  } else {
    strcpy(moodStr, "MOOD: CONTENT");
  }

  if (strcmp(moodStr, previousMoodString) != 0) {
    gfx->fillRect(0, 225, LCD_WIDTH, 20, 0x0000);
    gfx->setTextSize(2, 2, 0);
    int moodWidth = strlen(moodStr) * 6 * 2;
    gfx->setCursor((LCD_WIDTH - moodWidth) / 2, 225);
    gfx->print(moodStr);
    strcpy(previousMoodString, moodStr);
  }

  // Feed Button Box
  if (buttonPressed) {
    gfx->fillRoundRect(40, 260, 160, 45, 10, RGB565_WHITE); // Flash white fill
    gfx->setTextSize(2, 2, 0);
    gfx->setTextColor(0x0000); // Black text
    gfx->setCursor(85, 274);
    gfx->print("FEED ME");
  } else {
    gfx->fillRoundRect(40, 260, 160, 45, 10, 0x0000); // Black fill
    gfx->drawRoundRect(40, 260, 160, 45, 10, RGB565_WHITE); // White outline
    gfx->setTextSize(2, 2, 0);
    gfx->setTextColor(RGB565_WHITE); // White text
    gfx->setCursor(85, 274);
    gfx->print("FEED ME");
  }
}

// Floating food animation & stats update
void feedPet() {
  // 1. Flash the button
  drawUIElements(true);

  // 2. Animate floating food icon traveling up to the pet
  int startX = LCD_WIDTH / 2 - 6;
  int startY = 250;
  int endY = 140;

  for (int y = startY; y >= endY; y -= 12) {
    gfx->fillRect(startX, y, 12, 12, RGB565_WHITE);
    delay(20);
    gfx->fillRect(startX, y, 12, 12, 0x0000);
  }

  // 3. Increase happiness and trigger smile
  if (happiness < 10) {
    happiness = min(10, happiness + 3);
  }
  
  animState = 3; // Smile!
  drawPet(animState, 0);
  drawUIElements(false);
  delay(300);
}

// Direct I2C Touch Polling for CST816S / FT3168 Touch Controllers
bool readTouch(int16_t *x, int16_t *y) {
  Wire.beginTransmission(0x15); // Standard touch chip I2C address on many ESP32 touch boards
  Wire.write(0x02);
  if (Wire.endTransmission(false) == 0) {
    if (Wire.requestFrom(0x15, 5) >= 5) {
      uint8_t points = Wire.read();
      if (points > 0) {
        uint8_t xH = Wire.read();
        uint8_t xL = Wire.read();
        uint8_t yH = Wire.read();
        uint8_t yL = Wire.read();
        *x = ((xH & 0x0F) << 8) | xL;
        *y = ((yH & 0x0F) << 8) | yL;
        return true;
      }
    }
  }
  return false;
}

void setup() {
  USBSerial.begin(115200);

  if (!rtc.begin(Wire, IIC_SDA, IIC_SCL)) {
    while (1) { delay(1000); }
  }

  gfx->begin();
  gfx->fillScreen(0x0000);
  gfx->setBrightness(255);

  drawUIElements(false);
  drawPet(0, 0);
}

void loop() {
  uint32_t currentMillis = millis();

  // Hunger & Happiness Decay over time (Every 30 seconds lose 1 happiness)
  if (currentMillis - lastHungerMillis >= 30000) {
    lastHungerMillis = currentMillis;
    if (happiness > 0) {
      happiness--;
      drawUIElements(false);
    }
  }

  // Behavior & Animation Engine (Every 3 seconds)
  if (currentMillis - lastAnimMillis >= 3000) {
    lastAnimMillis = currentMillis;

    if (happiness <= 3) {
      animState = 0; 
    } else {
      animState = random(0, 6);
    }

    if (animState == 4) petOffsetX = -20;
    else if (animState == 5) petOffsetX = 20;
    else petOffsetX = 0;

    drawPet(animState, petOffsetX);
  }

  // Touch Handling for Feeding Button
  int16_t touchX, touchY;
  if (readTouch(&touchX, &touchY)) {
    // Check if touch hits the "FEED ME" button area (X: 40 to 200, Y: 260 to 305)
    if (touchX >= 40 && touchX <= 200 && touchY >= 260 && touchY <= 305) {
      feedPet();
    }
  }
}
