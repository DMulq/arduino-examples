  }

  RTC_DateTime dt = rtc.getDateTime();
  uint8_t hour = min((uint8_t)23, dt.getHour());
  uint8_t minute = min((uint8_t)59, dt.getMinute());

  char timeBuf[12];
  snprintf(timeBuf, sizeof(timeBuf), "%02d:%02d", hour, minute);

  // Clear top header strip
  gfx->fillRect(hudX + 6, hudY + 8, hudW - 12, 20, C_UI_BG);
  gfx->setTextSize(2);

  if (currentState == STATE_DEAD) {
    gfx->setTextColor(C_DANGER_RED);
    gfx->setCursor(hudX + 10, hudY + 10);
    gfx->print("R.I.P.");
  } else {
    // 1. DAY X in bright gold
    char dayBuf[16];
    snprintf(dayBuf, sizeof(dayBuf), "DAY %u", (unsigned int)daysAlive);
    gfx->setTextColor(C_WIN_SUN);
    gfx->setCursor(hudX + 8, hudY + 10);
    gfx->print(dayBuf);

    // 2. Real-time Clock
    gfx->setTextColor(C_WHITE);
    gfx->setCursor(hudX + 124, hudY + 10);
    gfx->print(timeBuf);
  }

  // 3. Battery Icon at far right
  drawBatteryIcon(hudX + 210, hudY + 10, batteryPercent, isCharging);

  // 4. Segmented Stat Bars
  if (starveStartTime > 0 && currentState != STATE_DEAD) {
    gfx->fillRect(hudX + 32, hudY + 34, 202, 16, C_DANGER_RED);
    gfx->setTextColor(C_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(hudX + 44, hudY + 36);
    gfx->print("! STARVING !");
  } else {
    drawSegmentedBar(hudX + 32, hudY + 34, 202, 16, hunger, 0xFA60);
  }

  drawSegmentedBar(hudX + 32, hudY + 56, 202, 16, happiness, 0x367A);
  drawSegmentedBar(hudX + 32, hudY + 78, 202, 16, energy, 0x4D7F);
}

void drawBottomDock(int8_t activeBtn) {
  int btnY = 368;
  int btnW = 96;
  int btnH = 54;
  int gap = 18;
  int startX = 22;

  if (currentState == STATE_DEAD) {
    gfx->fillRect(startX, btnY, SCREEN_W - (startX * 2), btnH, C_BLACK);
    int revW = 180;
    int revX = (SCREEN_W - revW) / 2;
    drawBevelBox(revX, btnY, revW, btnH, 0x8182, (activeBtn == 1));
    gfx->setTextColor((activeBtn == 1) ? C_WIN_SUN : C_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(revX + 44, btnY + 18);
    gfx->print("REVIVE");
    return;
  }

  const char* labels[3] = {
    "FEED", 
    "PLAY", 
    (currentState == STATE_SLEEP) ? "WAKE" : "REST"
  };
  uint16_t colors[3] = {0xB2A2, 0x2449, (currentState == STATE_SLEEP) ? 0x24B5 : 0x422A};

  for (int i = 0; i < 3; i++) {
    int bx = startX + i * (btnW + gap);
    bool pressed = (activeBtn == i);

    drawBevelBox(bx, btnY, btnW, btnH, colors[i], pressed);

    gfx->setTextColor(pressed ? C_WIN_SUN : C_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(bx + 20, btnY + 18);
    gfx->print(labels[i]);
  }
}

void erasePetRegion() {
  int x = PET_X;
  int w = SPRITE_SIZE * SPRITE_SCALE;

  gfx->fillRect(x, 190, w, 26, C_WALL_TOP);
  for (int sx = 8; sx < SCREEN_W; sx += 16) {
    if (sx >= x && sx < x + w) {
      gfx->drawFastVLine(sx, 190, 26, C_WALL_STRIPE);
    }
  }

  gfx->fillRect(x, 216, w, 8, C_WOOD_LIGHT);
  gfx->fillRect(x, 224, w, 20, C_WOOD_DARK);
  gfx->drawFastHLine(x, 216, w, C_UI_BORDER_LT);
  gfx->drawFastHLine(x, 244, w, C_BLACK);

  for (int y = 244; y < 330; y += 18) {
    for (int fx = 108; fx < 260; fx += 36) {
      bool alt = ((fx / 36) + (y / 18)) % 2 == 0;
      gfx->fillRect(fx, y, 36, 18, alt ? C_FLOOR_A : C_FLOOR_B);
      gfx->drawRect(fx, y, 36, 18, C_WOOD_DARK);
    }
  }

  gfx->fillEllipse(SCREEN_W / 2, 290, 110, 48, C_RUG_OUTER);
  gfx->fillEllipse(SCREEN_W / 2, 290, 95, 38, C_RUG_INNER);
  gfx->drawEllipse(SCREEN_W / 2, 290, 110, 48, C_WOOD_DARK);
}

void drawPetSprite(const uint8_t sprite[32][32]) {
  erasePetRegion();

  for (int py = 0; py < SPRITE_SIZE; py++) {
    for (int px = 0; px < SPRITE_SIZE; px++) {
      uint8_t colorIndex = pgm_read_byte(&(sprite[py][px]));
      if (colorIndex != 0) {
        uint16_t color = petPalette[colorIndex];
        gfx->fillRect(PET_X + (px * SPRITE_SCALE), PET_Y + (py * SPRITE_SCALE), SPRITE_SCALE, SPRITE_SCALE, color);
      }
    }
  }
}

bool readTouch(int16_t *x, int16_t *y) {
  Wire.beginTransmission(0x15);
  Wire.write(0x02);
  if (Wire.endTransmission(false) != 0) return false;

  if (Wire.requestFrom((uint8_t)0x15, (uint8_t)5) != 5) return false;

  uint8_t touches = Wire.read() & 0x0F;
  if (touches == 0) return false;

  uint8_t x_high = Wire.read() & 0x0F;
  uint8_t x_low  = Wire.read();
  uint8_t y_high = Wire.read() & 0x0F;
  uint8_t y_low  = Wire.read();

  *x = (x_high << 8) | x_low;
  *y = (y_high << 8) | y_low;
  return true;
}

void triggerFeed() {
  if (currentState == STATE_DEAD) return;
  drawBottomDock(0);
  soundFeed();
  hunger = min(100.0f, hunger + 25.0f);
  happiness = min(100.0f, happiness + 5.0f);
  starveStartTime = 0;

  if (currentState != STATE_SLEEP) {
    currentState = STATE_HAPPY;
    drawPetSprite(spriteHappy);
    moodResetTick = millis() + 1800;
  }
  delay(100);
  drawBottomDock(-1);
  drawTopHUD(false);
  savePetData();
}

void triggerPlay() {
  if (currentState == STATE_DEAD || currentState == STATE_SLEEP) return;
  drawBottomDock(1);
  soundPlay();
  happiness = min(100.0f, happiness + 25.0f);
  energy = max(0.0f, energy - 10.0f);
  currentState = STATE_HAPPY;
  drawPetSprite(spriteHappy);
  moodResetTick = millis() + 2000;
  delay(100);
  drawBottomDock(-1);
  drawTopHUD(false);
  savePetData();
}

void triggerSleepToggle() {
  if (currentState == STATE_DEAD) return;
  drawBottomDock(2);

  if (currentState == STATE_SLEEP) {
    currentState = STATE_IDLE;
    awakeStartTime = millis();
    soundFeed();
    drawPetSprite(spriteIdleA);
  } else {
    currentState = STATE_SLEEP;
    soundSleep();
    drawPetSprite(spriteSleep);
  }
  delay(100);
  drawBottomDock(-1);
  drawTopHUD(false);
  savePetData();
}

void triggerRevive() {
  drawBottomDock(1);
  soundRevive();
  delay(150);

  hunger = 80.0f;
  happiness = 80.0f;
  energy = 80.0f;
  daysAlive = 1;
  starveStartTime = 0;
  awakeStartTime = millis();
  currentState = STATE_IDLE;

  savePetData();

  drawRoomBackground();
  drawTopHUD(true);
  drawBottomDock(-1);
  drawPetSprite(spriteIdleA);
}

void triggerPetGesture() {
  if (currentState == STATE_DEAD || currentState == STATE_SLEEP) return;
  soundFeed();
  happiness = min(100.0f, happiness + 10.0f);
  currentState = STATE_HAPPY;
  drawPetSprite(spriteHappy);
  moodResetTick = millis() + 1400;
  drawTopHUD(false);
}

void setup() {
  USBSerial.begin(115200);

  #if BUZZER_PIN >= 0
    pinMode(BUZZER_PIN, OUTPUT);
  #endif

  Wire.begin(IIC_SDA, IIC_SCL);
  rtc.begin(Wire, IIC_SDA, IIC_SCL);

  // Check if RTC is uninitialized or invalid
  RTC_DateTime dt = rtc.getDateTime();
  if (dt.getYear() < 2024 || dt.getHour() > 23 || dt.getMinute() > 59 || dt.getDay() == 0 || dt.getDay() > 31) {
    calibrateRtcFromBuildTime();
    dt = rtc.getDateTime();
  }
  lastRecordedDay = dt.getDay();

  readBatteryPMIC();
  loadPetData();

  gfx->begin();
  gfx->fillScreen(C_BLACK);
  gfx->setBrightness(255);

  awakeStartTime = millis();

  drawRoomBackground();
  drawTopHUD(true);
  drawBottomDock(-1);

  if (currentState == STATE_DEAD) {
    drawPetSprite(spriteGhost);
  } else if (currentState == STATE_SLEEP) {
    drawPetSprite(spriteSleep);
  } else {
    drawPetSprite(spriteIdleA);
  }
}

void loop() {
  uint32_t now = millis();

  // 1. Safe Day Rollover: strictly evaluated once every 60 seconds
  if (now - lastDayCheckTick >= 60000) {
    lastDayCheckTick = now;
    RTC_DateTime dt = rtc.getDateTime();
    uint8_t currentDay = dt.getDay();

    if (currentDay >= 1 && currentDay <= 31 && currentDay != lastRecordedDay) {
      lastRecordedDay = currentDay;
      if (currentState != STATE_DEAD) {
        daysAlive++;
        savePetData();
        drawTopHUD(false);
      }
    }
  }

  // 2. Auto-Sleep after 4 continuous hours awake
  if (currentState != STATE_SLEEP && currentState != STATE_DEAD) {
    if (now - awakeStartTime >= AUTO_SLEEP_TIMEOUT_MS) {
      currentState = STATE_SLEEP;
      soundSleep();
      drawPetSprite(spriteSleep);
      drawBottomDock(-1);
      drawTopHUD(false);
      savePetData();
    }
  }

  // 3. Stat Decay & Starvation (Evaluated every 5s)
  if (now - lastStatTick >= 5000) {
    lastStatTick = now;

    if (currentState != STATE_DEAD) {
      if (currentState == STATE_SLEEP) {
        hunger = max(0.0f, hunger - 0.0058f);
        energy = min(100.0f, energy + 0.35f);
      } else {
        hunger = max(0.0f, hunger - 0.0174f);
        happiness = max(0.0f, happiness - 0.012f);
        energy = max(0.0f, energy - 0.010f);
      }

      // Starvation Warning Alert
      if (hunger <= 0.0f) {
        if (starveStartTime == 0) {
          starveStartTime = now;
          soundStarveAlarm();
        } else if (now - starveStartTime >= STARVE_GRACE_MS) {
          currentState = STATE_DEAD;
          drawPetSprite(spriteGhost);
          drawBottomDock(-1);
          savePetData();
        }
      }
      drawTopHUD(false);
    }
  }

  // 4. Periodic NVS Flash Save (Every 60s)
  if (now - lastSaveTick >= 60000) {
    lastSaveTick = now;
    savePetData();
  }

  // 5. Battery and Clock Refresh (Every 10s)
  if (now - lastClockTick >= 10000) {
    lastClockTick = now;
    readBatteryPMIC();
    drawTopHUD(false);
  }

  // 6. Idle Animations
  if (now - lastAnimTick >= 600) {
    lastAnimTick = now;
    currentAnimFrame = !currentAnimFrame;

    if (currentState == STATE_IDLE) {
      drawPetSprite(currentAnimFrame == 0 ? spriteIdleA : spriteIdleB);
    } else if (currentState == STATE_DEAD) {
      drawPetSprite(spriteGhost);
    }
  }

  // 7. Reset Temporary Emotion
  if (moodResetTick > 0 && now >= moodResetTick) {
    moodResetTick = 0;
    if (currentState == STATE_HAPPY) {
      currentState = STATE_IDLE;
      drawBottomDock(-1);
      drawPetSprite(spriteIdleA);
    }
  }

  // 8. Capacitive Touch Handling
  if (now - lastTouchTick >= 50) {
    lastTouchTick = now;
    int16_t tx, ty;
    if (readTouch(&tx, &ty)) {
      if (ty >= 360 && ty <= 435) {
        if (currentState == STATE_DEAD) {
          if (tx >= 90 && tx <= 278) {
            triggerRevive();
          }
        } else {
          if (tx >= 20 && tx <= 120) {
            triggerFeed();
          } else if (tx >= 134 && tx <= 234) {
            triggerPlay();
          } else if (tx >= 248 && tx <= 348) {
            triggerSleepToggle();
          }
        }
      } else if (ty >= 180 && ty <= 325 && tx >= 110 && tx <= 260) {
        triggerPetGesture();
      }
    }
  }
}
