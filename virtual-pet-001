  gfx->drawFastHLine(0, 244, SCREEN_W, C_BLACK);

  for (int y = 244; y < SCREEN_H; y += 18) {
    for (int x = 0; x < SCREEN_W; x += 36) {
      bool alt = ((x / 36) + (y / 18)) % 2 == 0;
      gfx->fillRect(x, y, 36, 18, alt ? C_FLOOR_A : C_FLOOR_B);
      gfx->drawRect(x, y, 36, 18, C_WOOD_DARK);
