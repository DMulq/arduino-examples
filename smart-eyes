void checkScheduledQuotes() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return;

  int hour = timeinfo.tm_hour;
  int min = timeinfo.tm_min;
  int sec = timeinfo.tm_sec;

  if (sec == 0) {
    if (hour == 11 && min == 30) {
      showQuote(0);
    } else if (hour == 16 && min == 0) {
      showQuote(1);
    } else if (hour == 9 && min == 0) {
      showQuote(4);
    }
  }

  uint32_t now = millis();
  if (hour >= 9 && hour < 17 && !quoteDisplayActive && !newsTickerActive && !celebrationActive && !lowBatteryAlertActive && !showNetworkStats) {
    if (now - lastQuoteTriggerMillis >= QUOTE_INTERVAL_MS) {
      lastQuoteTriggerMillis = now;
      int rIdx = random(2, 20);
      showQuote(rIdx);
    }
  }
}

void fetchSkyNews() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  http.begin(newsFeedUrl);
  int httpCode = http.GET();

  if (httpCode == HTTP_CODE_OK) {
    String payload = http.getString();
    int itemIdx = payload.indexOf("<item>");
    if (itemIdx != -1) {
      int titleStart = payload.indexOf("<title>", itemIdx);
      int titleEnd = payload.indexOf("</title>", titleStart);
      if (titleStart != -1 && titleEnd != -1) {
        String rawTitle = payload.substring(titleStart + 7, titleEnd);
        rawTitle.replace("&#39;", "'");
        rawTitle.replace("&amp;", "&");
        rawTitle.replace("&quot;", "\"");
        
        formatTextIntoPagesMax(rawTitle, newsPages, totalPages);
        
        newsTickerActive = true;
        lastPageSwitchTimer = millis();
        currentPageIndex = 0;
        playChime(true);
      }
    }
  }
  http.end();
}

