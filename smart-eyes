void formatTextIntoPagesMax(String text, String targetPages[], int &targetTotalPages) {
  targetTotalPages = 0;
  String lines[20];
  int totalLines = 0;

  String currentLine = "";
  int idx = 0;
  while (idx < text.length()) {
    int nextSpace = text.indexOf(' ', idx);
    String word = "";
    if (nextSpace == -1) {
      word = text.substring(idx);
      idx = text.length();
    } else {
      word = text.substring(idx, nextSpace);
      idx = nextSpace + 1;
    }

    if ((currentLine.length() + word.length() + 1) <= 9) {
      if (currentLine.length() > 0) currentLine += " ";
      currentLine += word;
    } else {
      lines[totalLines++] = currentLine;
      currentLine = word;
      if (totalLines >= 20) break;
    }
  }
  if (currentLine.length() > 0 && totalLines < 20) {
    lines[totalLines++] = currentLine;
  }

  for (int i = 0; i < totalLines; i += 3) {
    String pageStr = lines[i] + "\n";
    if (i + 1 < totalLines) pageStr += lines[i + 1] + "\n";
    else pageStr += "\n";
    if (i + 2 < totalLines) pageStr += lines[i + 2];
    else pageStr += "";

    targetPages[targetTotalPages++] = pageStr;
    if (targetTotalPages >= 6) break;
  }
}

