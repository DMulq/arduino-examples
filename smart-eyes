void handleSave() {
  if (server.hasArg("sleepStart"))   sleepStartHour   = server.arg("sleepStart").toInt();
  if (server.hasArg("sleepEnd"))     sleepEndHour     = server.arg("sleepEnd").toInt();
  if (server.hasArg("lunch"))        lunchHour        = server.arg("lunch").toInt();
  if (server.hasArg("dinner"))       dinnerHour     = server.arg("dinner").toInt();
  if (server.hasArg("brightness")) {
    screenBrightness = constrain(server.arg("brightness").toInt(), 10, 255);
    if (!isSleeping) gfx->setBrightness(screenBrightness);
  }
  if (server.hasArg("eyeColor")) {
    eyeColor = hexToRGB565(server.arg("eyeColor"));
  }

  saveSettings();
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleTimerStart() {
  if (server.hasArg("seconds")) {
    long secs = server.arg("seconds").toInt();
    if (secs > 0) {
      timerTotalSeconds = secs;
      timerStartMillis = millis();
      timerActive = true;
      celebrationActive = false;
      playChime(true);
    }
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void startSleepTransition(bool targetSleepState) {
  isSleeping = targetSleepState;
  sleepTransitionActive = true;
  sleepTransitionTimer = millis();

  if (isSleeping) {
    gfx->setBrightness(15); 
    playChime(false);
  } else {
    gfx->setBrightness(screenBrightness); 
    playChime(true);
  }
}

void handleTrigger() {
  if (server.hasArg("action")) {
    String act = server.arg("action");
    if (act == "burger") {
      eatingActive = true; eatingType = 1; eatingStartTime = millis(); playChime(true);
    } else if (act == "chicken") {
      eatingActive = true; eatingType = 2; eatingStartTime = millis(); playChime(true);
    } else if (act == "news") {
      fetchSkyNews();
    } else if (act == "quote") {
      showQuote(random(0, 20));
    } else if (act == "toggle_sleep") {
      startSleepTransition(!isSleeping);
    }
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void setupWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/timer", HTTP_POST, handleTimerStart);
  server.on("/trigger", HTTP_GET, handleTrigger);
  server.begin();
}

void connectWiFi() {
  WiFi.begin(primarySsid, primaryPassword);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 15) {
    delay(500);
    attempts++;
  }
  
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.begin(backupSsid, backupPassword);
    attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 15) {
      delay(500);
      attempts++;
    }
  }

  if (WiFi.status() == WL_CONNECTED) {
    configTzTime(ukTimeZone, ntpServer);
    setupWebServer();
    formatTextIntoPagesMax("Sky News Live: Welcome to your smart desktop companion!", newsPages, totalPages);
    lastNewsFetchMillis = millis();
  }
}

