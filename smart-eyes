void drawCustomEye(int cx, int cy, int w, int h, int r, int shapeType, uint16_t col) {
  if (shapeType == 0) {
    canvas->fillRoundRect(cx - w / 2, cy - h / 2, w, h, r, col);
  } 
  else if (shapeType == 1) {
    canvas->fillRoundRect(cx - w / 2, cy - h / 2, w, h, r, col);
    canvas->fillTriangle(cx - w/2 - 2, cy - h/2 - 2, cx - w/2 + 25, cy - h/2 - 2, cx - w/2 - 2, cy + h/2 + 2, C_BLACK);
  } 
  else if (shapeType == 2) {
    canvas->fillRoundRect(cx - w / 2, cy - h / 2, w, h, r, col);
    canvas->fillRect(cx - w/2 - 5, cy - h/2 - 10, w + 10, h/2, C_BLACK);
    canvas->fillRoundRect(cx - w/2, cy - h/2, w, h/2 + 5, r, col);
  } 
  else if (shapeType == 3) {
    canvas->fillRoundRect(cx - w / 2, cy - h / 2, w, h, r, col);
    if (cx < SCREEN_W / 2) {
      canvas->fillTriangle(cx + w/2 + 2, cy - h/2 - 2, cx + w/2 + 2, cy + h/2 + 2, cx, cy - h/2 - 2, C_BLACK);
    } else {
      canvas->fillTriangle(cx - w/2 - 2, cy - h/2 - 2, cx - w/2 - 2, cy + h/2 + 2, cx, cy - h/2 - 2, C_BLACK);
    }
  }
}

