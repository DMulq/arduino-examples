uint16_t hexToRGB565(String hex) {
  if (hex.startsWith("#")) hex = hex.substring(1);
  long number = strtol(hex.c_str(), NULL, 16);
  uint8_t r = (number >> 16) & 0xFF;
  uint8_t g = (number >> 8) & 0xFF;
  uint8_t b = number & 0xFF;
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}

String rgb565ToHex(uint16_t color) {
  uint8_t r = (color & 0xF800) >> 8;
  uint8_t g = (color & 0x07E0) >> 3;
  uint8_t b = (color & 0x001F) << 3;
  char buf[8];
  snprintf(buf, sizeof(buf), "#%02x%02x%02x", r, g, b);
  return String(buf);
}

void playTone(int frequency, int durationMs) {
  #if BUZZER_PIN >= 0
    pinMode(BUZZER_PIN, OUTPUT);
    long periodUs = 1000000L / frequency;
    long halfPeriodUs = periodUs / 2;
    long cycles = (long)frequency * durationMs / 1000;
    for (long i = 0; i < cycles; i++) {
      digitalWrite(BUZZER_PIN, HIGH);
      delayMicroseconds(halfPeriodUs);
      digitalWrite(BUZZER_PIN, LOW);
      delayMicroseconds(halfPeriodUs);
    }
    digitalWrite(BUZZER_PIN, LOW);
  #endif
}

void playChime(bool happy = true) {
  if (happy) {
    playTone(523, 80); delay(30);
    playTone(659, 80); delay(30);
    playTone(784, 120);
  } else {
    playTone(440, 200);
  }
}

