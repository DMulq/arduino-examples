void renderScene() {
  if (!canvasReady) return;

  if (showNetworkStats) {
    renderNetworkStatsScreen();
    return;
  }

  canvas->fillScreen(C_BLACK);

  if (!isCharging && batteryPercentage <= 10) {
    if (lowBatteryAlertActive) {
      if (millis() - lowBatteryAlertTimer > 60000) {
        lowBatteryAlertActive = false;
      }
    }
  } else {
    lowBatteryAlertActive = false;
  }

  if (celebrationActive) {
    int lx = (int)currentEyes.leftX;
    int ly = (int)currentEyes.leftY;
    int rx = (int)currentEyes.rightX;
    int ry = (int)currentEyes.rightY;

    canvas->drawArc(lx, ly - 45, 24, 20, 190, 350, C_WHITE);
    canvas->drawArc(rx, ry - 45, 24, 20, 190, 350, C_WHITE);

    drawKawaiiStarEye(lx, ly);
    drawKawaiiStarEye(rx, ry);

    canvas->fillCircle(lx - 15, ly + 55, 12, C_PINK);
    canvas->fillCircle(rx + 15, ry + 55, 12, C_PINK);

    int mx = (lx + rx) / 2;
    int my = ly + 50;
    canvas->fillCircle(mx, my, 18, C_BLACK);
    canvas->fillCircle(mx, my, 16, C_RED);
    canvas->fillTriangle(mx - 16, my - 10, mx + 16, my - 10, mx, my, C_BLACK);

    for (int i = 0; i < 25; i++) {
      canvas->fillCircle((int)confetti[i].x, (int)confetti[i].y, 4, confetti[i].color);
      confetti[i].y += confetti[i].speedY;
      confetti[i].x += confetti[i].speedX;
      if (confetti[i].y > SCREEN_H + 10) {
        confetti[i].y = random(-50, 0);
        confetti[i].x = random(10, SCREEN_W - 10);
      }
    }

    canvas->setTextSize(3);
    canvas->setTextColor(C_YELLOW);
    canvas->setCursor(85, 30);
    canvas->print("TIME'S UP!");

    if (millis() - celebrationTimer > 15000) {
      celebrationActive = false;
      applyExpression(0);
    }
  } 
  else {
    float lH = currentEyes.height * (1.0f - currentEyes.blinkAmount);
    float rH = currentEyes.height * (1.0f - currentEyes.blinkAmount);
    if (lH < 6) lH = 6;
    if (rH < 6) rH = 6;

    int lx = (int)currentEyes.leftX;
    int ly = (int)currentEyes.leftY; 
    int rx = (int)currentEyes.rightX;
    int ry = (int)currentEyes.rightY; 
    int w  = (int)currentEyes.width;
    int r  = (int)currentEyes.cornerRadius;
    int shape = targetEyes.shapeType;

    if (isSleeping && !sleepTransitionActive) {
      canvas->fillRoundRect(lx - w / 2, ly, w, 12, 4, eyeColor);
      canvas->fillRoundRect(rx - w / 2, ry, w, 12, 4, eyeColor);

      canvas->setTextSize(3);
      canvas->setTextColor(C_TIME_GOLD);
      for (int i = 0; i < 3; i++) {
        canvas->setCursor((int)zParticles[i].x, (int)zParticles[i].y);
        canvas->print("z");
        zParticles[i].y -= zParticles[i].speed;
        zParticles[i].x += 0.3f;
        if (zParticles[i].y < 30) {
          zParticles[i].y = 150;
          zParticles[i].x = 240 + random(0, 40);
        }
      }
    } 
    else {
      int chewOffset = 0;
      if (eatingActive) {
        chewOffset = (millis() / 150) % 2 == 0 ? -5 : 3;
      }

      drawCustomEye(lx, ly + chewOffset, w, (int)lH, r, shape, eyeColor);
      drawCustomEye(rx, ry + chewOffset, w, (int)rH, r, shape, eyeColor);

      if (timerActive) {
        unsigned long elapsedSec = (millis() - timerStartMillis) / 1000;
        long remainingSec = (long)timerTotalSeconds - (long)elapsedSec;

        if (remainingSec <= 0) {
          timerActive = false;
          celebrationActive = true;
          celebrationTimer = millis();
          initConfetti();
          playFanfare();
        } else {
          int mins = remainingSec / 60;
          int secs = remainingSec % 60;
          char timeBuf[10];
          snprintf(timeBuf, sizeof(timeBuf), "%02d:%02d", mins, secs);

          canvas->setTextSize(4);
          canvas->setTextColor(C_TIME_GOLD);
          canvas->setCursor(130, 40);
          canvas->print(timeBuf);
        }
      }

      if (lowBatteryAlertActive) {
        bool flashOn = (millis() / 400) % 2 == 0;
        uint16_t boxColor = flashOn ? C_RED : C_BLACK;

        canvas->fillRoundRect(15, 210, 338, 210, 12, boxColor);
        canvas->drawRoundRect(15, 210, 338, 210, 12, C_WHITE);

        canvas->setTextSize(3);
        canvas->setTextColor(C_WHITE);
        canvas->setCursor(30, 245);
        canvas->print("Battery at 10%!");
        canvas->setCursor(30, 305);
        canvas->print("Give me power!");
      }
      else if (quoteDisplayActive && totalQuotePages > 0) {
        canvas->fillRoundRect(15, 210, 338, 210, 12, C_BUBBLE_BG);
        canvas->drawRoundRect(15, 210, 338, 210, 12, C_BUBBLE_BRD);

        canvas->setTextSize(4);
        canvas->setTextColor(C_WHITE);
        
        String pageStr = quotePages[currentQuotePageIdx];
        int fN = pageStr.indexOf('\n');
        int sN = pageStr.indexOf('\n', fN + 1);

        String l1 = pageStr.substring(0, fN);
        String l2 = pageStr.substring(fN + 1, sN);
        String l3 = pageStr.substring(sN + 1);

        canvas->setCursor(22, 230);
        canvas->print(l1);
        canvas->setCursor(22, 275);
        canvas->print(l2);
        canvas->setCursor(22, 320);
        canvas->print(l3);

        if (millis() - lastQuoteSwitchTimer > 6000) {
          lastQuoteSwitchTimer = millis();
          currentQuotePageIdx++;
          if (currentQuotePageIdx >= totalQuotePages) {
            quoteDisplayActive = false;
            applyExpression(0);
          }
        }
      }
      else if (newsTickerActive && totalPages > 0) {
        canvas->fillRoundRect(15, 210, 338, 210, 12, C_BUBBLE_BG);
        canvas->drawRoundRect(15, 210, 338, 210, 12, C_BUBBLE_BRD);

        canvas->setTextSize(4);
        canvas->setTextColor(C_WHITE);
        
        String pageStr = newsPages[currentPageIndex];
        int firstNewline = pageStr.indexOf('\n');
        int secondNewline = pageStr.indexOf('\n', firstNewline + 1);

        String line1 = pageStr.substring(0, firstNewline);
        String line2 = pageStr.substring(firstNewline + 1, secondNewline);
        String line3 = pageStr.substring(secondNewline + 1);

        canvas->setCursor(22, 230);
        canvas->print(line1);
        canvas->setCursor(22, 275);
        canvas->print(line2);
        canvas->setCursor(22, 320);
        canvas->print(line3);

        if (millis() - lastPageSwitchTimer > 6000) {
          lastPageSwitchTimer = millis();
          currentPageIndex++;
          if (currentPageIndex >= totalPages) {
            newsTickerActive = false;
            applyExpression(0);
          }
        }
      }

      if (eatingActive) {
        uint32_t elapsed = millis() - eatingStartTime;
        if (elapsed >= EATING_DURATION_MS) {
          eatingActive = false;
          applyExpression(0);
        } else {
          float progress = (float)elapsed / (float)EATING_DURATION_MS;
          float remainingRatio = 1.0f - progress;

          if (eatingType == 1) {
            drawBurger(280, 100 + chewOffset, remainingRatio);
          } else if (eatingType == 2) {
            drawChickenLeg(275, 105 + chewOffset, remainingRatio);
          }
        }
      }
    }
  }

  canvas->flush();
}

void setup() {
  USBSerial.begin(115200);
  delay(500);

  pinMode(BOOT_BUTTON_PIN, INPUT_PULLUP);

  #if BUZZER_PIN >= 0
    pinMode(BUZZER_PIN, OUTPUT);
  #endif

  gfx->begin();
  gfx->fillScreen(C_BLACK);

  loadSettings();
  gfx->setBrightness(isSleeping ? 15 : screenBrightness);

  randomSeed(analogRead(0));

  if (canvas->begin(GFX_SKIP_OUTPUT_BEGIN)) {
    canvasReady = true;
  }

  connectWiFi();
  applyExpression(0);
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }

  // Handle BOOT button press with debounce
  int currentButtonState = digitalRead(BOOT_BUTTON_PIN);
  if (currentButtonState == LOW && lastButtonState == HIGH) {
    if (millis() - lastDebounceTime > 250) {
      lastDebounceTime = millis();
      showNetworkStats = !showNetworkStats; // Toggle stats screen
      playChime(true);
    }
  }
  lastButtonState = currentButtonState;

  uint32_t now = millis();

  // If viewing network stats, refresh screen periodically and skip eyes/quotes loop
  if (showNetworkStats) {
    renderScene();
    delay(500);
    return;
  }

  if (WiFi.status() == WL_CONNECTED && !isSleeping && !celebrationActive && !lowBatteryAlertActive) {
    if (now - lastNewsFetchMillis >= NEWS_FETCH_INTERVAL_MS) {
      lastNewsFetchMillis = now;
      fetchSkyNews();
    }
  }

  if (!lowBatteryAlertActive) {
    checkScheduledQuotes();
  }

  if (sleepTransitionActive) {
    uint32_t tElapsed = now - sleepTransitionTimer;
    if (isSleeping) {
      if (tElapsed < 400) {
        targetEyes = {114, 175, 254, 175, 100, 60, 20, 0.4f, 0};
      } else if (tElapsed < 800) {
        targetEyes = {114, 170, 254, 170, 100, 80, 25, 0.2f, 0};
      } else if (tElapsed < 1300) {
        targetEyes = {114, 180, 254, 180, 100, 40, 15, 0.7f, 0};
      } else if (tElapsed < 1700) {
        targetEyes = {114, 178, 254, 178, 100, 50, 18, 0.5f, 0};
      } else if (tElapsed < 2400) {
        targetEyes = {114, 185, 254, 185, 105, 20, 8, 0.95f, 0};
      } else {
        sleepTransitionActive = false;
      }
    } else {
      if (tElapsed < 600) {
        targetEyes = {114, 160, 254, 160, 100, 110, 35, 0.0f, 0};
      } else {
        sleepTransitionActive = false;
      }
    }
  }

  if (!sleepTransitionActive) {
    struct tm timeinfo;
    if (getLocalTime(&timeinfo)) {
      int hour = timeinfo.tm_hour;
      int min = timeinfo.tm_min;
      int sec = timeinfo.tm_sec;

      bool shouldSleep = false;
      if (sleepStartHour > sleepEndHour) {
        shouldSleep = (hour >= sleepStartHour || hour < sleepEndHour);
      } else {
        shouldSleep = (hour >= sleepStartHour && hour < sleepEndHour);
      }

      if (shouldSleep != isSleeping) {
        startSleepTransition(shouldSleep);
      }

      if (!isSleeping && hour == lunchHour && min == 0 && sleepTransitionActive == false && !eatingActive && !celebrationActive && !lowBatteryAlertActive) {
        eatingActive = true; eatingType = 1; eatingStartTime = now;
        targetEyes = {114, 165, 254, 165, 110, 75, 20, 0.0f, 1}; playChime(true);
      }

      if (!isSleeping && hour == dinnerHour && min == 0 && sleepTransitionActive == false && !eatingActive && !celebrationActive && !lowBatteryAlertActive) {
        eatingActive = true; eatingType = 2; eatingStartTime = now;
        targetEyes = {114, 165, 254, 165, 110, 75, 20, 0.0f, 1}; playChime(true);
      }
    }
  }

  float easing = 0.15f;
  float diff = abs(targetEyes.leftX - currentEyes.leftX) + 1.0f; 

  if (diff > 0.05f || isSleeping || eatingActive || sleepTransitionActive || newsTickerActive || quoteDisplayActive || timerActive || celebrationActive || lowBatteryAlertActive) {
    currentEyes.leftX += (targetEyes.leftX - currentEyes.leftX) * easing;
    currentEyes.leftY += (targetEyes.leftY - currentEyes.leftY) * easing;
    currentEyes.rightX += (targetEyes.rightX - currentEyes.rightX) * easing;
    currentEyes.rightY += (targetEyes.rightY - currentEyes.rightY) * easing;
    currentEyes.width += (targetEyes.width - currentEyes.width) * easing;
    currentEyes.height += (targetEyes.height - currentEyes.height) * easing;
    currentEyes.cornerRadius += (targetEyes.cornerRadius - currentEyes.cornerRadius) * easing;
    currentEyes.blinkAmount += (targetEyes.blinkAmount - currentEyes.blinkAmount) * easing;
    currentEyes.shapeType = targetEyes.shapeType;

    renderScene();
    delay(20);
  } else {
    delay(40);
  }

  if (!isSleeping && !eatingActive && !sleepTransitionActive && !celebrationActive && !lowBatteryAlertActive) {
    if (!isBlinking && random(0, 70) == 1) {
      isBlinking = true;
      targetEyes.blinkAmount = 0.95f;
      blinkTimer = now + 120;
    }
    if (isBlinking && now >= blinkTimer) {
      isBlinking = false;
      targetEyes.blinkAmount = 0.0f;
    }

    if (now - lastActionTime >= nextInterval) {
      lastActionTime = now;
      nextInterval = random(3000, 6000);

      if (now - lastRareExpressionMillis >= RARE_EXPRESSION_INTERVAL_MS) {
        lastRareExpressionMillis = now;
        int rareExp = random(2, 4); 
        applyExpression(rareExp);
      } else {
        int normalExp = random(0, 2); 
        applyExpression(normalExp);
      }
    }
  } else if ((isSleeping || celebrationActive || lowBatteryAlertActive) && !sleepTransitionActive) {
    renderScene();
    delay(40);
  }
}
