  }
}

void drawStar(int cx, int cy, int r, uint16_t color) {
  canvas->fillCircle(cx, cy, r / 3, color);
  canvas->fillRect(cx - r, cy - 2, r * 2, 4, color);
  canvas->fillRect(cx - 2, cy - r, 4, r * 2, color);
  canvas->fillTriangle(cx - r, cy, cx, cy - r, cx - r/2, cy - r/2, color);
  canvas->fillTriangle(cx + r, cy, cx, cy - r, cx + r/2, cy - r/2, color);
  canvas->fillTriangle(cx - r, cy, cx, cy + r, cx - r/2, cy + r/2, color);
  canvas->fillTriangle(cx + r, cy, cx, cy + r, cx + r/2, cy + r/2, color);
}

void drawBurger(int x, int y, float remainingRatio) {
  int fullW = 60;
  int currentW = (int)(fullW * remainingRatio);
  if (currentW <= 0) return;

  canvas->fillRoundRect(x, y + 30, currentW, 14, 4, C_BUN_BROWN);
  if (currentW > 12) canvas->fillRect(x + 5, y + 18, currentW - 10, 12, C_PATTY_DARK);
  if (currentW > 24) canvas->fillRect(x + 10, y + 10, currentW - 20, 8, C_LETTUCE);
  canvas->fillRoundRect(x, y, currentW, 16, 6, C_BUN_BROWN);
}

void drawChickenLeg(int x, int y, float remainingRatio) {
  int fullLen = 60;
  int currentLen = (int)(fullLen * remainingRatio);
  if (currentLen <= 0) return;

  canvas->fillRoundRect(x, y + 12, 20, 10, 3, C_BONE_WHITE);
  if (currentLen > 18) {
    canvas->fillCircle(x + 26, y + 17, min(20, (int)(20 * remainingRatio)), C_MEAT_BROWN);
  }
}

void renderScene() {
  if (!canvasReady) return;

  canvas->fillScreen(C_BLACK);

  // --- CELEBRATION MODE (Star Eyes & Confetti) ---
  if (celebrationActive) {
    // Draw Star Eyes
    drawStar((int)currentEyes.leftX, (int)currentEyes.leftY, 45, C_YELLOW);
    drawStar((int)currentEyes.rightX, (int)currentEyes.rightY, 45, C_YELLOW);

    // Render & update falling confetti
    for (int i = 0; i < 25; i++) {
      canvas->fillCircle((int)confetti[i].x, (int)confetti[i].y, 4, confetti[i].color);
      confetti[i].y += confetti[i].speedY;
      confetti[i].x += confetti[i].speedX;
      if (confetti[i].y > SCREEN_H + 10) {
        confetti[i].y = random(-50, 0);
        confetti[i].x = random(10, SCREEN_W - 10);
      }
    }

    // Display "TIME'S UP!" message
    canvas->setTextSize(3);
    canvas->setTextColor(C_YELLOW);
    canvas->setCursor(85, 80);
    canvas->print("TIME'S UP!");

    if (millis() - celebrationTimer > 15000) {
      celebrationActive = false;
      applyExpression(0);
    }
  } 
  else {
    float lH = currentEyes.height * (1.0f - currentEyes.blinkAmount);
    float rH = currentEyes.height * (1.0f - currentEyes.blinkAmount);
    if (lH < 6) lH = 6;
    if (rH < 6) rH = 6;

    int lx = (int)currentEyes.leftX;
    int ly = (int)currentEyes.leftY; 
    int rx = (int)currentEyes.rightX;
    int ry = (int)currentEyes.rightY; 
    int w  = (int)currentEyes.width;
    int r  = (int)currentEyes.cornerRadius;

    if (isSleeping && !sleepTransitionActive) {
      canvas->fillRoundRect(lx - w / 2, ly, w, 12, 4, eyeColor);
      canvas->fillRoundRect(rx - w / 2, ry, w, 12, 4, eyeColor);

      canvas->setTextSize(3);
      canvas->setTextColor(C_TIME_GOLD);
      for (int i = 0; i < 3; i++) {
        canvas->setCursor((int)zParticles[i].x, (int)zParticles[i].y);
        canvas->print("z");
        zParticles[i].y -= zParticles[i].speed;
        zParticles[i].x += 0.3f;
        if (zParticles[i].y < 30) {
          zParticles[i].y = 150;
          zParticles[i].x = 240 + random(0, 40);
        }
      }
    } 
    else {
      int chewOffset = 0;
      if (eatingActive) {
        chewOffset = (millis() / 150) % 2 == 0 ? -5 : 3;
      }

      canvas->fillRoundRect(lx - w / 2, (ly + chewOffset) - (int)lH / 2, w, (int)lH, r, eyeColor);
      canvas->fillRoundRect(rx - w / 2, (ry + chewOffset) - (int)rH / 2, w, (int)rH, r, eyeColor);

      if (timerActive) {
        unsigned long elapsedSec = (millis() - timerStartMillis) / 1000;
        long remainingSec = (long)timerTotalSeconds - (long)elapsedSec;

        if (remainingSec <= 0) {
          timerActive = false;
          celebrationActive = true;
          celebrationTimer = millis();
          initConfetti();
          playChime(true);
          playChime(true);
          playChime(true);
        } else {
          int mins = remainingSec / 60;
          int secs = remainingSec % 60;
          char timeBuf[10];
          snprintf(timeBuf, sizeof(timeBuf), "%02d:%02d", mins, secs);

          canvas->setTextSize(4);
          canvas->setTextColor(C_TIME_GOLD);
          canvas->setCursor(130, 40);
          canvas->print(timeBuf);
        }
      }

      if (newsTickerActive && totalPages > 0 && !timerActive) {
        canvas->fillRoundRect(20, 230, 328, 170, 12, C_BUBBLE_BG);
        canvas->drawRoundRect(20, 230, 328, 170, 12, C_BUBBLE_BRD);

        canvas->setTextSize(2);
        canvas->setTextColor(C_WHITE);
        
        String pageStr = newsPages[currentPageIndex];
        int firstNewline = pageStr.indexOf('\n');
        int secondNewline = pageStr.indexOf('\n', firstNewline + 1);

        String line1 = pageStr.substring(0, firstNewline);
        String line2 = pageStr.substring(firstNewline + 1, secondNewline);
        String line3 = pageStr.substring(secondNewline + 1);

        canvas->setCursor(35, 255);
        canvas->print(line1);
        canvas->setCursor(35, 295);
        canvas->print(line2);
        canvas->setCursor(35, 335);
        canvas->print(line3);

        if (millis() - lastPageSwitchTimer > 5000) {
          lastPageSwitchTimer = millis();
          currentPageIndex++;
          if (currentPageIndex >= totalPages) {
            newsTickerActive = false;
            applyExpression(0);
          }
        }
      }

      if (eatingActive) {
        uint32_t elapsed = millis() - eatingStartTime;
        if (elapsed >= EATING_DURATION_MS) {
          eatingActive = false;
          applyExpression(0);
        } else {
          float progress = (float)elapsed / (float)EATING_DURATION_MS;
          float remainingRatio = 1.0f - progress;

          if (eatingType == 1) {
            drawBurger(280, 100 + chewOffset, remainingRatio);
          } else if (eatingType == 2) {
            drawChickenLeg(275, 105 + chewOffset, remainingRatio);
          }
        }
      }
    }
  }

  if (screenBorderActive) {
    canvas->drawRect(0, 0, SCREEN_W, SCREEN_H, C_RED);
    canvas->drawRect(1, 1, SCREEN_W - 2, SCREEN_H - 2, C_RED);
  }

  canvas->flush();
}

void setup() {
  USBSerial.begin(115200);
  delay(500);

  #if BUZZER_PIN >= 0
    pinMode(BUZZER_PIN, OUTPUT);
  #endif

  gfx->begin();
  gfx->fillScreen(C_BLACK);

  loadSettings();
  gfx->setBrightness(isSleeping ? 15 : screenBrightness);

  randomSeed(analogRead(0));

  if (canvas->begin(GFX_SKIP_OUTPUT_BEGIN)) {
    canvasReady = true;
  }

  connectWiFi();
  applyExpression(0);
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }

  uint32_t now = millis();

  if (WiFi.status() == WL_CONNECTED && !isSleeping && !timerActive && !celebrationActive) {
    if (now - lastNewsFetchMillis >= NEWS_FETCH_INTERVAL_MS) {
      lastNewsFetchMillis = now;
      fetchSkyNews();
    }
  }

  if (sleepTransitionActive) {
    uint32_t tElapsed = now - sleepTransitionTimer;
    if (isSleeping) {
      if (tElapsed < 400) {
        targetEyes = {114, 175, 254, 175, 100, 60, 20, 0.4f};
      } else if (tElapsed < 800) {
        targetEyes = {114, 170, 254, 170, 100, 80, 25, 0.2f};
      } else if (tElapsed < 1300) {
        targetEyes = {114, 180, 254, 180, 100, 40, 15, 0.7f};
      } else if (tElapsed < 1700) {
        targetEyes = {114, 178, 254, 178, 100, 50, 18, 0.5f};
      } else if (tElapsed < 2400) {
        targetEyes = {114, 185, 254, 185, 105, 20, 8, 0.95f};
      } else {
        sleepTransitionActive = false;
      }
    } else {
      if (tElapsed < 600) {
        targetEyes = {114, 160, 254, 160, 100, 110, 35, 0.0f};
      } else {
        sleepTransitionActive = false;
      }
    }
  }

  if (!sleepTransitionActive) {
    struct tm timeinfo;
    if (getLocalTime(&timeinfo)) {
      int hour = timeinfo.tm_hour;
      int min = timeinfo.tm_min;
      int sec = timeinfo.tm_sec;

      bool shouldSleep = false;
      if (sleepStartHour > sleepEndHour) {
        shouldSleep = (hour >= sleepStartHour || hour < sleepEndHour);
      } else {
        shouldSleep = (hour >= sleepStartHour && hour < sleepEndHour);
      }

      if (shouldSleep != isSleeping) {
        startSleepTransition(shouldSleep);
      }

      if (!isSleeping && hour == lunchHour && min == 0 && sec == 0 && !eatingActive && !timerActive && !celebrationActive) {
        eatingActive = true; eatingType = 1; eatingStartTime = now;
        targetEyes = {114, 165, 254, 165, 110, 75, 20, 0.0f}; playChime(true);
      }

      if (!isSleeping && hour == dinnerHour && min == 0 && sec == 0 && !eatingActive && !timerActive && !celebrationActive) {
        eatingActive = true; eatingType = 2; eatingStartTime = now;
        targetEyes = {114, 165, 254, 165, 110, 75, 20, 0.0f}; playChime(true);
      }
    }
  }

  float easing = 0.15f;
  float diff = abs(targetEyes.leftX - currentEyes.leftX) + 1.0f; 

  if (diff > 0.05f || isSleeping || eatingActive || sleepTransitionActive || newsTickerActive || timerActive || celebrationActive || screenBorderActive) {
    currentEyes.leftX += (targetEyes.leftX - currentEyes.leftX) * easing;
    currentEyes.leftY += (targetEyes.leftY - currentEyes.leftY) * easing;
    currentEyes.rightX += (targetEyes.rightX - currentEyes.rightX) * easing;
    currentEyes.rightY += (targetEyes.rightY - currentEyes.rightY) * easing;
    currentEyes.width += (targetEyes.width - currentEyes.width) * easing;
    currentEyes.height += (targetEyes.height - currentEyes.height) * easing;
    currentEyes.cornerRadius += (targetEyes.cornerRadius - currentEyes.cornerRadius) * easing;
    currentEyes.blinkAmount += (targetEyes.blinkAmount - currentEyes.blinkAmount) * easing;

    renderScene();
    delay(20);
  } else {
    delay(40);
  }

  if (!isSleeping && !eatingActive && !sleepTransitionActive && !newsTickerActive && !timerActive && !celebrationActive) {
    if (!isBlinking && random(0, 70) == 1) {
      isBlinking = true;
      targetEyes.blinkAmount = 0.95f;
      blinkTimer = now + 120;
    }
    if (isBlinking && now >= blinkTimer) {
      isBlinking = false;
      targetEyes.blinkAmount = 0.0f;
    }

    if (now - lastActionTime >= nextInterval) {
      lastActionTime = now;
      nextInterval = random(3000, 6000);
      currentExp = random(0, 10);
      applyExpression(currentExp);
    }
  } else if ((isSleeping || celebrationActive) && !sleepTransitionActive) {
    renderScene();
    delay(40);
  }
}
