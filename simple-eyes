void formatHeadlineIntoPages(String headline) {
  totalPages = 0;
  String lines[15];
  int totalLines = 0;

  String currentLine = "";
  int idx = 0;
  while (idx < headline.length()) {
    int nextSpace = headline.indexOf(' ', idx);
    String word = "";
    if (nextSpace == -1) {
      word = headline.substring(idx);
      idx = headline.length();
    } else {
      word = headline.substring(idx, nextSpace);
      idx = nextSpace + 1;
    }

    if ((currentLine.length() + word.length() + 1) <= 24) {
      if (currentLine.length() > 0) currentLine += " ";
      currentLine += word;
    } else {
      lines[totalLines++] = currentLine;
      currentLine = word;
      if (totalLines >= 15) break;
    }
  }
  if (currentLine.length() > 0 && totalLines < 15) {
    lines[totalLines++] = currentLine;
  }

  for (int i = 0; i < totalLines; i += 3) {
    String pageStr = lines[i] + "\n";
    if (i + 1 < totalLines) pageStr += lines[i + 1] + "\n";
    else pageStr += "\n";
    if (i + 2 < totalLines) pageStr += lines[i + 2];
    else pageStr += "";

    newsPages[totalPages++] = pageStr;
    if (totalPages >= 5) break;
  }
  currentPageIndex = 0;
}

void fetchSkyNews() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  http.begin(newsFeedUrl);
  int httpCode = http.GET();

  if (httpCode == HTTP_CODE_OK) {
    String payload = http.getString();
    int itemIdx = payload.indexOf("<item>");
    if (itemIdx != -1) {
      int titleStart = payload.indexOf("<title>", itemIdx);
      int titleEnd = payload.indexOf("</title>", titleStart);
      if (titleStart != -1 && titleEnd != -1) {
        String rawTitle = payload.substring(titleStart + 7, titleEnd);
        rawTitle.replace("&#39;", "'");
        rawTitle.replace("&amp;", "&");
        rawTitle.replace("&quot;", "\"");
        
        formatHeadlineIntoPages(rawTitle);
        
        newsTickerActive = true;
        lastPageSwitchTimer = millis();
        currentPageIndex = 0;
        playChime(true);
      }
    }
  }
  http.end();
}

